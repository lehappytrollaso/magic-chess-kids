<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="16dp">

    <!-- Top Navigation & Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnTutorialBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTutorialTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Jumping Knight"
                android:textColor="@color/primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTutorialStepCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 3"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnTutorialSound"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_sound_on"
            android:padding="10dp"
            android:contentDescription="Sound" />
    </LinearLayout>

    <!-- Sparky Speech Bubble -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_speech_bubble"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_robot_sparky"
            android:contentDescription="Sparky" />

        <TextView
            android:id="@+id/tvTutorialInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="The knight hops in an L-shape: 2 steps straight and 1 to the side."
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Interactive Chess Board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.antigravity.magicchesskids.ChessBoardView
            android:id="@+id/chessBoardTutorial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Challenge Helpers: Hint & Retry -->
    <LinearLayout
        android:id="@+id/containerTutorialTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <!-- Hint Button -->
        <LinearLayout
            android:id="@+id/btnTutorialHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_gold"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_hint"
                android:contentDescription="Hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Hint 💡"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Retry Button -->
        <LinearLayout
            android:id="@+id/btnTutorialRestart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_accent"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_restart"
                android:contentDescription="Restart challenge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Retry 🔄"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls / Continue button -->
    <LinearLayout
        android:id="@+id/containerTutorialAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnTutorialAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:text="Got it! Let's practice 🚀"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
