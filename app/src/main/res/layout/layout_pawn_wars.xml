<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="12dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnPawnWarsBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_arrow_back"
            android:padding="11dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pawn Wars ⚔️"
            android:textColor="@color/primary_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btnPawnWarsRestart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_restart"
            android:padding="11dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Restart" />

        <ImageView
            android:id="@+id/btnPawnWarsTheme"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_theme_palette"
            android:padding="11dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Themes" />

        <ImageView
            android:id="@+id/btnPawnWarsSound"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_sound_on"
            android:padding="11dp"
            android:contentDescription="Sound" />
    </LinearLayout>

    <!-- Sparky Speech Bubble -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_speech_bubble"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivPawnWarsSparky"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_robot_sparky"
            android:contentDescription="Sparky" />

        <TextView
            android:id="@+id/tvPawnWarsMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Advance your pawns! First one across the board wins! 🛡️"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chess Board View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.antigravity.magicchesskids.ChessBoardView
            android:id="@+id/chessBoardPawnWars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Status & Action Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/btnPawnWarsHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_gold"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginEnd="6dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_hint"
                android:contentDescription="Hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Hint 💡"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPawnWarsUndo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginStart="6dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_undo"
                android:contentDescription="Undo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Undo ↩️"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
