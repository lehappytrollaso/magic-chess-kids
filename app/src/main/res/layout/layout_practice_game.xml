<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="12dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnGameBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_arrow_back"
            android:padding="11dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Friendly Match"
            android:textColor="@color/primary_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btnGameRestart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_restart"
            android:padding="11dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Restart" />

        <ImageView
            android:id="@+id/btnGameSound"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_sound_on"
            android:padding="11dp"
            android:contentDescription="Sound" />
    </LinearLayout>

    <!-- Sparky Opponent Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:elevation="2dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_robot_sparky"
            android:contentDescription="Sparky" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sparky 🤖 (Black)"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSparkyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi champion! Ready to play? 😊"
                android:textColor="@color/primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Captured White pieces by Sparky -->
        <TextView
            android:id="@+id/tvCapturedByBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Interactive Chess Board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.antigravity.magicchesskids.ChessBoardView
            android:id="@+id/chessBoardGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Player Card (White) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_circle">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/piece_queen_white"
                android:contentDescription="You" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You (White) 👑"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="It's your turn! Tap a piece to move"
                android:textColor="@color/accent_mint"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Captured Black pieces by Player -->
        <TextView
            android:id="@+id/tvCapturedByWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Assistant Controls Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <!-- Hint Button -->
        <LinearLayout
            android:id="@+id/btnGameHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_gold"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_hint"
                android:contentDescription="Hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Hint 💡"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Undo Button -->
        <LinearLayout
            android:id="@+id/btnGameUndo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_undo"
                android:contentDescription="Undo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Undo ↩️"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
