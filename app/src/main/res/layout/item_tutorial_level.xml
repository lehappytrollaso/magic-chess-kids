<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_rounded"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_circle">

        <ImageView
            android:id="@+id/ivLevelIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/piece_pawn_white"
            android:contentDescription="Piece" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvLevelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Little Pawn"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLevelSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One step forward, diagonal nibble"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- Star ratings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/ivStar1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Star 1" />

            <ImageView
                android:id="@+id/ivStar2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Star 2" />

            <ImageView
                android:id="@+id/ivStar3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Star 3" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivActionIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_arrow_forward"
        android:contentDescription="Open" />

</LinearLayout>
