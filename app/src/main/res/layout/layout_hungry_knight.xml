<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="12dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnHungryKnightBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_arrow_back"
            android:padding="11dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Hungry Knight 🦄"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHungryKnightStage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1 of 3"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHungryKnightRestart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_restart"
            android:padding="11dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Restart" />

        <ImageView
            android:id="@+id/btnHungryKnightTheme"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_theme_palette"
            android:padding="11dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Themes" />

        <ImageView
            android:id="@+id/btnHungryKnightSound"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_sound_on"
            android:padding="11dp"
            android:contentDescription="Sound" />
    </LinearLayout>

    <!-- Sparky Speech Bubble -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_speech_bubble"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivHungryKnightSparky"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_robot_sparky"
            android:contentDescription="Sparky" />

        <TextView
            android:id="@+id/tvHungryKnightMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="L-jump to collect all stars ⭐! Watch out for the hot lava traps 🔥!"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chess Board View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.antigravity.magicchesskids.ChessBoardView
            android:id="@+id/chessBoardHungryKnight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Action Button -->
    <Button
        android:id="@+id/btnHungryKnightAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next Level! 🚀"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_accent"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
